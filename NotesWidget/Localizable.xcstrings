    "Your open tasks. Tap a circle to tick one off.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou oop take. Tik op ’n sirkel om dit af te merk."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهامك المفتوحة. اضغط على دائرة لإنجاز مهمة."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার খোলা কাজ। টিক দিতে একটি বৃত্তে ট্যাপ করুন।"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەرکە کراوەکانت. بۆ نیشانەکردن دەست لە بازنەیەک بدە."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše otevřené úkoly. Klepnutím na kroužek úkol odškrtnete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine åbne opgaver. Tryk på en cirkel for at krydse den af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine offenen Aufgaben. Tippe auf einen Kreis, um sie abzuhaken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ανοιχτές εργασίες σας. Πατήστε έναν κύκλο για να την τσεκάρετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas pendientes. Toca un círculo para marcarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu avatud ülesanded. Märkimiseks puuduta ringi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای باز شما. برای تیک زدن روی دایره ضربه بزنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoimet tehtäväsi. Merkitse tehdyksi napauttamalla ympyrää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches en cours. Touchez un cercle pour en cocher une."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות הפתוחות שלך. יש להקיש על עיגול כדי לסמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खुले कार्य। टिक करने के लिए गोले पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyitott feladataid. Koppints egy körre a kipipáláshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas terbuka Anda. Ketuk lingkaran untuk mencentangnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività aperte. Tocca un cerchio per spuntarne una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了のタスクです。丸をタップしてチェックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 작업입니다. 원을 탭하여 체크하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugasan terbuka anda. Ketik bulatan untuk menandakannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine åpne oppgaver. Trykk på en sirkel for å hake av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je open taken. Tik op een cirkel om er een af te vinken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje otwarte zadania. Stuknij kółko, aby je odhaczyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas tarefas pendentes. Toque num círculo para concluir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile tale deschise. Apasă un cerc ca s-o bifezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши открытые задачи. Нажмите на кружок, чтобы отметить."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши отворени задаци. Додирните круг да га штиклирате."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina öppna uppgifter. Tryck på en cirkel för att bocka av."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่ยังเปิดอยู่ของคุณ แตะวงกลมเพื่อติ๊ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık görevleriniz. İşaretlemek için bir daireye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші відкриті завдання. Торкніться кружечка, щоб позначити."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کھلے کام۔ نشان لگانے کے لیے دائرے پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc đang mở của bạn. Chạm vào vòng tròn để đánh dấu."
          }
        }
      }
    },
    "Your pinned and recent notes.": {
      "localizations": {
        "af": {
          "stringUnit": {
