    "When on, your notes stay hidden until you unlock the app, including in the app switcher." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer dit aan is, bly jou notas versteek totdat jy die app ontsluit, ook in die appwisselaar."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التشغيل، تبقى ملاحظاتك مخفية حتى تفتح قفل التطبيق، بما في ذلك في مبدّل التطبيقات."
          }
        },
        "bn-BD" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালু থাকলে, অ্যাপ আনলক না করা পর্যন্ত আপনার নোট লুকানো থাকে, অ্যাপ সুইচারেও।"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کاتێک هەڵکرابێت، تێبینییەکانت شاراوە دەمێننەوە تا قفڵی بەرنامە دەکەیتەوە، تەنانەت لە گۆڕەری بەرنامەکانیشدا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je‑li zapnuto, poznámky zůstanou skryté, dokud aplikaci neodemknete, i v přepínači aplikací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, er dine noter skjult, indtil du låser appen op, også i appvælgeren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, bleiben deine Notizen verborgen, bis du die App entsperrst – auch in der App-Übersicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργό, οι σημειώσεις μένουν κρυφές μέχρι να ξεκλειδώσετε την εφαρμογή, και στην εναλλαγή εφαρμογών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, tus notas quedan ocultas hasta que desbloquees la app, también en el selector de apps."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui see on sees, jäävad märkmed peidetuks kuni rakenduse avamiseni, ka rakenduste vahetajas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی روشن باشد، یادداشت‌ها تا باز شدن قفل برنامه پنهان می‌مانند، حتی در جابه‌جاکننده برنامه‌ها."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on päällä, muistiinpanosi pysyvät piilossa, kunnes avaat apin, myös apinvaihtajassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, vos notes restent masquées tant que l’app n’est pas déverrouillée, y compris dans le sélecteur d’apps."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהאפשרות פועלת, הפתקים מוסתרים עד לביטול נעילת היישום, גם במחליף היישומים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चालू होने पर, ऐप अनलॉक करने तक आपके नोट्स छिपे रहते हैं, ऐप स्विचर में भी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha be van kapcsolva, a jegyzetek rejtve maradnak az app feloldásáig, az appváltóban is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika aktif, catatan Anda tersembunyi sampai Anda membuka kunci app, termasuk di pengalih app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, le note restano nascoste finché non sblocchi l’app, anche nel selettore delle app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、Appのロックを解除するまでメモは非表示になります。Appスイッチャーでも同様です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 앱 잠금을 해제할 때까지 메모가 숨겨집니다. 앱 전환기에서도 마찬가지입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila dihidupkan, nota anda tersembunyi sehingga anda membuka kunci app, termasuk dalam penukar app."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er på, er notatene skjult til du låser opp appen, også i appveksleren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit aan staat, blijven je notities verborgen tot je de app ontgrendelt, ook in de appkiezer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, notatki są ukryte do czasu odblokowania aplikacji, także w przełączniku aplikacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, as notas ficam ocultas até desbloquear a app, incluindo no seletor de apps."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activată, notițele rămân ascunse până deblochezi aplicația, inclusiv în comutatorul de aplicații."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, заметки скрыты, пока вы не разблокируете приложение, в том числе в переключателе приложений."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Када је укључено, белешке остају скривене док не откључате апликацију, и у прегледу апликација."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är på döljs dina anteckningar tills du låser upp appen, även i appväxlaren."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดอยู่ โน้ตของคุณจะถูกซ่อนจนกว่าคุณจะปลดล็อกแอป รวมถึงในตัวสลับแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık olduğunda notlarınız, uygulama değiştiricide de dahil olmak üzere, uygulamanın kilidini açana kadar gizli kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, нотатки приховані, доки ви не розблокуєте програму, зокрема в перемикачі програм."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آن ہونے پر، آپ کے نوٹس ایپ انلاک کرنے تک چھپے رہتے ہیں، ایپ سوئچر میں بھی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, ghi chú sẽ ẩn cho đến khi bạn mở khóa ứng dụng, kể cả trong trình chuyển ứng dụng."
          }
        }
      }
    },
    "Write a title or some text first." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryf eers ’n titel of ’n bietjie teks."
