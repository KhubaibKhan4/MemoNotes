    "Line numbers appear in a note's description. Preview shows the start of each note in the notes list." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lynnommers word in die notabeskrywing gewys. Voorskou wys die begin van elke nota in die lys."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر أرقام الأسطر في وصف الملاحظة. تعرض المعاينة بداية كل ملاحظة في القائمة."
          }
        },
        "bn-BD" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোটের বিবরণে লাইন নম্বর দেখা যায়। প্রিভিউ তালিকায় প্রতিটি নোটের শুরু দেখায়।"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ژمارەی دێڕەکان لە وەسفی تێبینیدا پیشان دەدرێن. پێشبینین سەرەتای هەر تێبینییەک لە لیستەکەدا پیشان دەدات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čísla řádků se zobrazují v popisu poznámky. Náhled ukazuje začátek každé poznámky v seznamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjenumre vises i notens beskrivelse. Eksempel viser starten af hver note på listen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilennummern erscheinen in der Beschreibung einer Notiz. Die Vorschau zeigt den Anfang jeder Notiz in der Liste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αριθμοί γραμμών εμφανίζονται στην περιγραφή της σημείωσης. Η προεπισκόπηση δείχνει την αρχή κάθε σημείωσης στη λίστα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números de línea aparecen en la descripción de la nota. La vista previa muestra el inicio de cada nota en la lista."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanumbrid kuvatakse märkme kirjelduses. Eelvaade näitab loendis iga märkme algust."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شماره خطوط در توضیحات یادداشت نشان داده می‌شود. پیش‌نمایش ابتدای هر یادداشت را در فهرست نشان می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivinumerot näkyvät muistiinpanon kuvauksessa. Esikatselu näyttää jokaisen muistiinpanon alun listassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les numéros de ligne apparaissent dans la description d’une note. L’aperçu affiche le début de chaque note dans la liste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספרי שורות מופיעים בתיאור הפתק. התצוגה המקדימה מראה את תחילת כל פתק ברשימה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पंक्ति संख्याएँ नोट के विवरण में दिखती हैं। पूर्वावलोकन सूची में हर नोट की शुरुआत दिखाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sorszámok a jegyzet leírásában jelennek meg. Az előnézet minden jegyzet elejét mutatja a listában."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomor baris ditampilkan di deskripsi catatan. Pratinjau menampilkan awal setiap catatan di daftar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I numeri di riga compaiono nella descrizione della nota. L’anteprima mostra l’inizio di ogni nota nell’elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行番号はメモの説明に表示されます。プレビューでは、リストに各メモの冒頭が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄 번호는 메모 설명에 표시됩니다. 미리보기는 목록에서 각 메모의 시작 부분을 보여줍니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombor baris dipaparkan dalam penerangan nota. Pratonton menunjukkan permulaan setiap nota dalam senarai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjenumre vises i notatets beskrivelse. Forhåndsvisning viser starten av hvert notat i listen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regelnummers verschijnen in de beschrijving van een notitie. Voorvertoning toont het begin van elke notitie in de lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numery wierszy pojawiają się w opisie notatki. Podgląd pokazuje początek każdej notatki na liście."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os números de linha aparecem na descrição da nota. A pré-visualização mostra o início de cada nota na lista."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numerele de rând apar în descrierea notiței. Previzualizarea arată începutul fiecărei notițe în listă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номера строк показываются в описании заметки. Предпросмотр показывает начало каждой заметки в списке."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бројеви редова се приказују у опису белешке. Преглед приказује почетак сваке белешке на листи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radnummer visas i anteckningens beskrivning. Förhandsvisning visar början av varje anteckning i listan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หมายเลขบรรทัดจะแสดงในคำอธิบายโน้ต การแสดงตัวอย่างจะแสดงตอนต้นของแต่ละโน้ตในรายการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satır numaraları not açıklamasında görünür. Önizleme, listede her notun başını gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номери рядків показуються в описі нотатки. Попередній перегляд показує початок кожної нотатки в списку."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سطر نمبر نوٹ کی تفصیل میں دکھائے جاتے ہیں۔ پیش منظر فہرست میں ہر نوٹ کا آغاز دکھاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số dòng hiển thị trong mô tả ghi chú. Xem trước hiển thị phần đầu của mỗi ghi chú trong danh sách."
          }
        }
      }
