    "Notes you delete stay here for %lld days before they're removed." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas wat jy uitvee, bly %lld dae hier voordat hulle verwyder word."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الملاحظات التي تحذفها هنا لمدة %lld يومًا قبل إزالتها."
          }
        },
        "bn-BD" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার মোছা নোটগুলো সরানোর আগে %lld দিন এখানে থাকে।"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ئەو تێبینییانەی دەیانسڕیتەوە %lld ڕۆژ لێرە دەمێننەوە پێش ئەوەی لاببرێن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazané poznámky tu zůstanou %lld dní, než budou odstraněny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slettede noter bliver her i %lld dage, før de fjernes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Notizen bleiben hier %lld Tage, bevor sie entfernt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σημειώσεις που διαγράφετε μένουν εδώ για %lld ημέρες πριν αφαιρεθούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas que elimines se quedan aquí %lld días antes de borrarse."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
