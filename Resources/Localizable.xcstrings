    "You'll get a notification at the due time." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy sal ’n kennisgewing op die sperdatum kry."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيصلك إشعار في موعد الاستحقاق."
          }
        },
        "bn-BD" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেষ সময়ে আপনি নোটিফিকেশন পাবেন।"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لە کاتی کۆتاییدا ئاگادارکردنەوەیەک وەردەگریت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V termínu dostanete oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får en notifikation, når opgaven forfalder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erhältst zum Fälligkeitszeitpunkt eine Mitteilung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα λάβετε ειδοποίηση την ώρα λήξης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibirás una notificación a la hora de vencimiento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saad tähtajal märguande."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در زمان سررسید اعلان دریافت می‌کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ilmoituksen määräaikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous recevrez une notification à l’échéance."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יתקבל עדכון במועד היעד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नियत समय पर आपको सूचना मिलेगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A határidőkor értesítést kapsz."
          }
        },
        "id" : {
          "stringUnit" : {
