    "Sign in to iCloud in the Settings app and your notes, checklists and todos sync across your iPhone, iPad and Mac automatically." : {
      "extractionState" : "manual"
    },
    "Sign in to iCloud in the Settings app to sync notes and todos across your devices." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meld in Instellings by iCloud aan om notas en take oor jou toestelle te sinkroniseer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول إلى iCloud في الإعدادات لمزامنة الملاحظات والمهام عبر أجهزتك."
          }
        },
        "bn-BD" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিভাইস জুড়ে নোট ও কাজ সিঙ্ক করতে সেটিংসে iCloud-এ সাইন ইন করুন।"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بۆ هاوکاتکردنی تێبینی و ئەرکەکان لە نێوان ئامێرەکانت، لە ڕێکخستنەکان بچۆ ناو iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete‑li synchronizovat poznámky a úkoly mezi zařízeními, přihlaste se k iCloudu v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind på iCloud i Indstillinger for at synkronisere noter og opgaver mellem dine enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich in den Einstellungen bei iCloud an, um Notizen und Aufgaben auf deinen Geräten zu synchronisieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε στο iCloud στις Ρυθμίσεις για να συγχρονίζετε σημειώσεις και εργασίες στις συσκευές σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en iCloud en Ajustes para sincronizar notas y tareas entre tus dispositivos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Märkmete ja ülesannete sünkroonimiseks seadmete vahel logi menüüs Seaded iCloudi sisse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای همگام‌سازی یادداشت‌ها و کارها بین دستگاه‌ها، در تنظیمات وارد iCloud شوید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu iCloudiin Asetuksissa, niin voit synkronoida muistiinpanot ja tehtävät laitteidesi välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
