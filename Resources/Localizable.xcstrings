        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 메모, 할 일 및 설정이 삭제됩니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua nota, tugasan dan seting anda akan dipadam. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle notater, oppgaver og innstillinger slettes. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al je notities, taken en instellingen worden gewist. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie notatki, zadania i ustawienia zostaną usunięte. Tej czynności nie można cofnąć."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as suas notas, tarefas e definições serão apagadas. Esta ação não pode ser anulada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
