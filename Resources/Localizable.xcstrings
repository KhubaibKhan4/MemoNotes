    "This will erase all your notes, todos, and settings. This cannot be undone." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al jou notas, take en instellings sal uitgevee word. Dit kan nie ontdoen word nie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف كل ملاحظاتك ومهامك وإعداداتك. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn-BD" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সব নোট, কাজ ও সেটিংস মুছে যাবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هەموو تێبینی، ئەرک و ڕێکخستنەکانت دەسڕدرێنەوە. ئەمە ناگەڕێتەوە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny vaše poznámky, úkoly a nastavení budou smazány. Tuto akci nelze vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle dine noter, opgaver og indstillinger slettes. Dette kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Notizen, Aufgaben und Einstellungen gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι σημειώσεις, οι εργασίες και οι ρυθμίσεις σας θα διαγραφούν. Αυτή η ενέργεια δεν αναιρείται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán todas tus notas, tareas y ajustes. Esta acción no se puede deshacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik sinu märkmed, ülesanded ja seaded kustutatakse. Seda ei saa tagasi võtta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه یادداشت‌ها، کارها و تنظیمات شما حذف می‌شوند. این کار برگشت‌پذیر نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki muistiinpanosi, tehtäväsi ja asetuksesi poistetaan. Tätä ei voi kumota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes vos notes, tâches et réglages seront effacés. Cette action est irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל הפתקים, המשימות וההגדרות שלך יימחקו. לא ניתן לבטל פעולה זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सभी नोट्स, कार्य और सेटिंग्स हटा दी जाएँगी। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden jegyzeted, feladatod és beállításod törlődik. Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua catatan, tugas, dan pengaturan Anda akan dihapus. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno cancellati tutte le note, le attività e le impostazioni. L’azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
