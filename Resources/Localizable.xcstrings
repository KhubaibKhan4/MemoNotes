        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota, senarai, foto, tugasan dan peringatan diselaraskan dengan peranti lain anda yang menggunakan akaun iCloud yang sama. Video kekal pada peranti tempat ia ditambah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notater, sjekklister, bilder, oppgaver og påminnelser synkroniseres med de andre enhetene dine med samme iCloud-konto. Videoer blir på enheten de ble lagt til på."
          }
        },
        "nl" : {
          "stringUnit" : {
