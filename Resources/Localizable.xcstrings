    "Created on this iPhone with Apple Intelligence. Check it before relying on it." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op hierdie iPhone met Apple Intelligence geskep. Gaan dit na voordat jy daarop staatmaak."
