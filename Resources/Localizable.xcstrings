    "Notifications are used for reminders on notes and todos." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kennisgewings word vir herinneringe by notas en take gebruik."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم الإشعارات لتذكيرات الملاحظات والمهام."
          }
        },
        "bn-BD" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোট ও কাজের রিমাইন্ডারের জন্য নোটিফিকেশন ব্যবহার হয়।"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ئاگادارکردنەوەکان بۆ بیرخستنەوەی تێبینی و ئەرکەکان بەکار دێن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení slouží k připomínkám poznámek a úkolů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationer bruges til påmindelser om noter og opgaver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen werden für Erinnerungen zu Notizen und Aufgaben verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις χρησιμοποιούνται για υπενθυμίσεις σημειώσεων και εργασιών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones se usan para los recordatorios de notas y tareas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Märguandeid kasutatakse märkmete ja ülesannete meeldetuletuste jaoks."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان‌ها برای یادآوری یادداشت‌ها و کارها استفاده می‌شوند."
