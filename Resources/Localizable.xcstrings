    "Swipe right to restore a note. Notes are removed for good after %lld days." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swiep regs om ’n nota te herstel. Notas word ná %lld dae permanent verwyder."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لليمين لاستعادة ملاحظة. تُزال الملاحظات نهائيًا بعد %lld يومًا."
          }
        },
        "bn-BD" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোট পুনরুদ্ধার করতে ডানে সোয়াইপ করুন। %lld দিন পরে নোট চিরতরে সরানো হয়।"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بۆ گەڕاندنەوەی تێبینی بەرەو ڕاست ڕایبکێشە. تێبینییەکان دوای %lld ڕۆژ بە یەکجاری لادەبرێن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámku obnovíte přejetím doprava. Poznámky jsou po %lld dnech odstraněny natrvalo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skub til højre for at gendanne en note. Noter fjernes permanent efter %lld dage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche nach rechts, um eine Notiz wiederherzustellen. Notizen werden nach %lld Tagen endgültig entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώστε δεξιά για ανάκτηση σημείωσης. Οι σημειώσεις αφαιρούνται οριστικά μετά από %lld ημέρες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la derecha para recuperar una nota. Las notas se borran para siempre a los %lld días."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Märkme taastamiseks pühi paremale. Märkmed eemaldatakse jäädavalt %lld päeva pärast."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای بازگرداندن یادداشت به راست بکشید. یادداشت‌ها پس از %lld روز برای همیشه پاک می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauta muistiinpano pyyhkäisemällä oikealle. Muistiinpanot poistetaan pysyvästi %lld päivän jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la droite pour restaurer une note. Les notes sont effacées définitivement après %lld jours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להחליק ימינה כדי לשחזר פתק. פתקים מוסרים לצמיתות אחרי %lld ימים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट पुनर्स्थापित करने के लिए दाएँ स्वाइप करें। नोट्स %lld दिन बाद हमेशा के लिए हटा दिए जाते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jegyzet visszaállításához legyints jobbra. A jegyzetek %lld nap után véglegesen törlődnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser ke kanan untuk memulihkan catatan. Catatan dihapus permanen setelah %lld hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a destra per recuperare una nota. Le note vengono rimosse definitivamente dopo %lld giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右にスワイプするとメモを復元できます。メモは%lld日後に完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모를 복구하려면 오른쪽으로 쓸어넘기십시오. 메모는 %lld일 후 영구적으로 제거됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leret ke kanan untuk memulihkan nota. Nota dibuang selama-lamanya selepas %lld hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip til høyre for å gjenopprette et notat. Notater fjernes for godt etter %lld dager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar rechts om een notitie terug te zetten. Notities worden na %lld dagen definitief gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w prawo, aby przywrócić notatkę. Notatki są usuwane na zawsze po %lld dniach."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a direita para recuperar uma nota. As notas são removidas definitivamente após %lld dias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisează la dreapta ca să recuperezi o notiță. Notițele sunt eliminate definitiv după %lld de zile."
