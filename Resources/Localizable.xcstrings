        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додирните + да напишете прву белешку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på + för att skriva din första anteckning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ + เพื่อเขียนโน้ตแรกของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk notunuzu yazmak için + simgesine dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться +, щоб написати першу нотатку."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا پہلا نوٹ لکھنے کے لیے + پر ٹیپ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm + để viết ghi chú đầu tiên."
          }
        }
      }
    },
    "Tap a folder to rename it. Deleting a folder keeps its notes in All Notes." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op ’n vouer om dit te hernoem. As jy ’n vouer uitvee, bly sy notas in Alle notas."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على مجلد لإعادة تسميته. عند حذف مجلد تبقى ملاحظاته في كل الملاحظات."
          }
        },
        "bn-BD" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নাম বদলাতে একটি ফোল্ডারে ট্যাপ করুন। ফোল্ডার মুছলে এর নোটগুলো সব নোটে থাকে।"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بۆ گۆڕینی ناو دەست لە بوخچەیەک بدە. سڕینەوەی بوخچە تێبینییەکانی لە هەموو تێبینییەکاندا دەهێڵێتەوە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na složku ji přejmenujete. Po smazání složky zůstanou její poznámky ve Všech poznámkách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en mappe for at omdøbe den. Hvis du sletter en mappe, bliver noterne i Alle noter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Ordner, um ihn umzubenennen. Beim Löschen eines Ordners bleiben seine Notizen unter „Alle Notizen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε έναν φάκελο για να τον μετονομάσετε. Αν διαγράψετε έναν φάκελο, οι σημειώσεις του μένουν στις Όλες οι σημειώσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una carpeta para renombrarla. Al eliminar una carpeta, sus notas siguen en Todas las notas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kausta ümbernimetamiseks puuduta seda. Kausta kustutamisel jäävad selle märkmed kausta Kõik märkmed."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای تغییر نام، روی پوشه ضربه بزنید. با حذف پوشه، یادداشت‌های آن در «همه یادداشت‌ها» می‌مانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimeä kansio uudelleen napauttamalla sitä. Kun poistat kansion, sen muistiinpanot jäävät kohtaan Kaikki muistiinpanot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un dossier pour le renommer. Supprimer un dossier conserve ses notes dans Toutes les notes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להקיש על תיקייה כדי לשנות את שמה. מחיקת תיקייה משאירה את הפתקים שלה ב״כל הפתקים״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाम बदलने के लिए फ़ोल्डर पर टैप करें। फ़ोल्डर हटाने पर उसके नोट्स सभी नोट्स में रहते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints egy mappára az átnevezéséhez. Mappa törlésekor a jegyzetei az Összes jegyzet között maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk folder untuk mengganti namanya. Menghapus folder tetap menyimpan catatannya di Semua Catatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una cartella per rinominarla. Eliminando una cartella, le sue note restano in Tutte le note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダをタップすると名前を変更できます。フォルダを削除しても、メモは「すべてのメモ」に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더를 탭하여 이름을 변경하십시오. 폴더를 삭제해도 메모는 모든 메모에 남아 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik folder untuk menamakannya semula. Memadam folder mengekalkan notanya dalam Semua Nota."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en mappe for å gi den nytt navn. Sletter du en mappe, blir notatene i Alle notater."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een map om de naam te wijzigen. Als je een map verwijdert, blijven de notities in Alle notities."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij folder, aby zmienić jego nazwę. Po usunięciu folderu jego notatki pozostaną we Wszystkich notatkach."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque numa pasta para mudar o nome. Ao apagar uma pasta, as notas ficam em Todas as notas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apasă un dosar ca să-l redenumești. Dacă ștergi un dosar, notițele lui rămân în Toate notițele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на папку, чтобы переименовать её. При удалении папки её заметки останутся во Всех заметках."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додирните фасциклу да је преименујете. Када обришете фасциклу, њене белешке остају у Свим белешкама."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en mapp för att byta namn. Om du raderar en mapp finns anteckningarna kvar i Alla anteckningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะโฟลเดอร์เพื่อเปลี่ยนชื่อ การลบโฟลเดอร์จะเก็บโน้ตไว้ในโน้ตทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden adlandırmak için bir klasöre dokunun. Klasör silindiğinde notları Tüm Notlar’da kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться папки, щоб перейменувати її. Після видалення папки її нотатки залишаться в Усіх нотатках."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام بدلنے کے لیے فولڈر پر ٹیپ کریں۔ فولڈر حذف کرنے پر اس کے نوٹس تمام نوٹس میں رہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào thư mục để đổi tên. Khi xóa thư mục, ghi chú trong đó vẫn ở Tất cả ghi chú."
          }
        }
      }
    },
