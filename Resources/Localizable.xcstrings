        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi chú, danh sách, ảnh, việc và lời nhắc được đồng bộ với các thiết bị khác dùng cùng tài khoản iCloud. Video ở lại trên thiết bị đã thêm chúng."
          }
        }
