    "Its notes won't be deleted. They'll stay in All Notes." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die notas daarin sal nie uitgevee word nie. Hulle bly in Alle notas."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تُحذف ملاحظاته. ستبقى في كل الملاحظات."
          }
        },
        "bn-BD" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এর নোটগুলো মুছবে না। সেগুলো সব নোটে থাকবে।"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تێبینییەکانی ناسڕدرێنەوە. لە هەموو تێبینییەکاندا دەمێننەوە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámky ve složce se nesmažou. Zůstanou ve Všech poznámkách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noterne slettes ikke. De bliver i Alle noter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notizen werden nicht gelöscht. Sie bleiben unter „Alle Notizen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σημειώσεις του δεν θα διαγραφούν. Θα παραμείνουν στις Όλες οι σημειώσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus notas no se eliminarán. Seguirán en Todas las notas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle märkmeid ei kustutata. Need jäävad kausta Kõik märkmed."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یادداشت‌های آن حذف نمی‌شوند و در «همه یادداشت‌ها» می‌مانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistiinpanoja ei poisteta. Ne jäävät kohtaan Kaikki muistiinpanot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses notes ne seront pas supprimées. Elles resteront dans Toutes les notes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפתקים שבה לא יימחקו. הם יישארו ב״כל הפתקים״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके नोट्स नहीं हटाए जाएँगे। वे सभी नोट्स में रहेंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jegyzetei nem törlődnek, az Összes jegyzet között maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatannya tidak akan dihapus. Catatan tetap ada di Semua Catatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le note non verranno eliminate. Resteranno in Tutte le note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ内のメモは削除されず、「すべてのメモ」に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더의 메모는 삭제되지 않으며 모든 메모에 남아 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notanya tidak akan dipadam. Nota akan kekal dalam Semua Nota."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notatene slettes ikke. De blir værende i Alle notater."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De notities worden niet verwijderd. Ze blijven in Alle notities."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notatki nie zostaną usunięte. Pozostaną we Wszystkich notatkach."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notas não serão apagadas. Ficam em Todas as notas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notițele nu vor fi șterse. Rămân în Toate notițele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Её заметки не будут удалены. Они останутся во Всех заметках."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Њене белешке неће бити обрисане. Остаће у Свим белешкама."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteckningarna raderas inte. De finns kvar i Alla anteckningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โน้ตในโฟลเดอร์จะไม่ถูกลบ และจะยังอยู่ในโน้ตทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notları silinmeyecek. Tüm Notlar’da kalacaklar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Її нотатки не буде видалено. Вони залишаться в Усіх нотатках."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کے نوٹس حذف نہیں ہوں گے۔ وہ تمام نوٹس میں رہیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi chú trong đó sẽ không bị xóa. Chúng vẫn ở trong Tất cả ghi chú."
          }
        }
      }
    },
