    "Photos are only saved with notes.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s word net saam met notas gestoor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الصور مع الملاحظات فقط."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি শুধু নোটের সঙ্গে সংরক্ষিত হয়।"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وێنەکان تەنها لەگەڵ تێبینییەکان پاشەکەوت دەکرێن."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky se ukládají jen s poznámkami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billeder gemmes kun med noter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos werden nur mit Notizen gesichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες αποθηκεύονται μόνο με σημειώσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos solo se guardan con las notas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotod salvestatakse ainult märkmetega."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس‌ها فقط همراه یادداشت ذخیره می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat tallennetaan vain muistiinpanoihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos ne sont enregistrées qu’avec les notes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות נשמרות רק עם פתקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो केवल नोट्स के साथ सहेजी जाती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotók csak jegyzetekkel együtt menthetők."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto hanya disimpan bersama catatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto vengono salvate solo con le note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はメモと一緒にのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 메모와 함께만 저장됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto hanya disimpan bersama nota."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder lagres bare med notater."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's worden alleen bij notities bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia są zapisywane tylko w notatkach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias só são guardadas com notas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele se salvează doar cu notițe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото сохраняются только вместе с заметками."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Фотографије се чувају само уз белешке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder sparas bara med anteckningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพจะบันทึกพร้อมโน้ตเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar yalnızca notlarla kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото зберігаються лише разом із нотатками."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر صرف نوٹس کے ساتھ محفوظ ہوتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh chỉ được lưu cùng ghi chú."
          }
        }
      }
    },
