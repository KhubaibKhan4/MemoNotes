    "Saving from other apps isn't available yet. Open CloudNote AI, then try again.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoor uit ander apps is nog nie beskikbaar nie. Maak CloudNote AI oop en probeer dan weer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحفظ من التطبيقات الأخرى غير متاح بعد. افتح CloudNote AI ثم حاول مجددًا."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য অ্যাপ থেকে সংরক্ষণ এখনও উপলব্ধ নয়। CloudNote AI খুলে আবার চেষ্টা করুন।"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پاشەکەوتکردن لە بەرنامەکانی ترەوە هێشتا بەردەست نییە. CloudNote AI بکەرەوە، پاشان دووبارە هەوڵ بدەوە."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládání z jiných aplikací zatím není k dispozici. Otevřete CloudNote AI a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er endnu ikke muligt at gemme fra andre apps. Åbn CloudNote AI, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern aus anderen Apps ist noch nicht verfügbar. Öffne CloudNote AI und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποθήκευση από άλλες εφαρμογές δεν είναι ακόμη διαθέσιμη. Ανοίξτε το CloudNote AI και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se puede guardar desde otras apps. Abre CloudNote AI y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teistest rakendustest salvestamine pole veel saadaval. Ava CloudNote AI ja proovi uuesti."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیره از برنامه‌های دیگر هنوز در دسترس نیست. CloudNote AI را باز کنید و دوباره امتحان کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaminen muista apeista ei ole vielä käytettävissä. Avaa CloudNote AI ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement depuis d’autres apps n’est pas encore disponible. Ouvrez CloudNote AI, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירה מיישומים אחרים עדיין אינה זמינה. יש לפתוח את CloudNote AI ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे ऐप्स से सहेजना अभी उपलब्ध नहीं है। CloudNote AI खोलें, फिर कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A más appokból való mentés még nem érhető el. Nyisd meg a CloudNote AI-t, majd próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan dari app lain belum tersedia. Buka CloudNote AI, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio da altre app non è ancora disponibile. Apri CloudNote AI e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのAppからの保存はまだ利用できません。CloudNote AIを開いてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱에서 저장하기는 아직 사용할 수 없습니다. CloudNote AI를 연 다음 다시 시도하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan daripada app lain belum tersedia. Buka CloudNote AI, kemudian cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagring fra andre apper er ikke tilgjengelig ennå. Åpne CloudNote AI, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaren vanuit andere apps is nog niet beschikbaar. Open CloudNote AI en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisywanie z innych aplikacji nie jest jeszcze dostępne. Otwórz CloudNote AI i spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não é possível guardar a partir de outras apps. Abra o CloudNote AI e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvarea din alte aplicații nu este încă disponibilă. Deschide CloudNote AI și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение из других приложений пока недоступно. Откройте CloudNote AI и повторите попытку."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Чување из других апликација још није доступно. Отворите CloudNote AI, па покушајте поново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att spara från andra appar än. Öppna CloudNote AI och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่สามารถบันทึกจากแอปอื่นได้ เปิด CloudNote AI แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamalardan kaydetme henüz kullanılamıyor. CloudNote AI’ı açın ve yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збереження з інших програм поки недоступне. Відкрийте CloudNote AI і спробуйте ще раз."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسری ایپس سے محفوظ کرنا ابھی دستیاب نہیں۔ CloudNote AI کھولیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể lưu từ ứng dụng khác. Hãy mở CloudNote AI rồi thử lại."
          }
        }
      }
    },
