    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID word gebruik om jou notas te ontsluit wanneer die app-slot aan is."
